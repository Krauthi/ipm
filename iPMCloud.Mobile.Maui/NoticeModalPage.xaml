<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="iPMCloud.Mobile.NoticeModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vo="clr-namespace:iPMCloud.Mobile.vo"
    BackgroundColor="#000000">

    <Grid
        Margin="0,0,0,0"
        Padding="0"
        HorizontalOptions="Fill"
        RowSpacing="0"
        VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="NoticePage_position_Container"
            Grid.Row="0"
            Margin="0"
            Padding="0"
            HorizontalOptions="Fill"
            RowSpacing="0"
            VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="0"
                Padding="1"
                ColumnSpacing="0"
                HeightRequest="54"
                HorizontalOptions="Fill">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="btn_back_notice"
                    Grid.Column="0"
                    Margin="3,2,2,2"
                    Padding="1"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Stroke="Transparent"
                    VerticalOptions="Center">
                    <Grid
                        Margin="0"
                        Padding="0"
                        ColumnSpacing="0"
                        HeightRequest="38"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            HeightRequest="30"
                            HorizontalOptions="Start"
                            Source="DropLeftBlueDoubleImage.png"
                            VerticalOptions="Center"
                            WidthRequest="30" />
                        <Label
                            Grid.Column="1"
                            Margin="0"
                            FontSize="18"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            LineBreakMode="TailTruncation"
                            Text="ABBRECHEN"
                            TextColor="#3f94cd"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label
                    x:Name="btn_alertmessage_tit"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    FontSize="22"
                    HorizontalOptions="End"
                    HorizontalTextAlignment="End"
                    LineBreakMode="TailTruncation"
                    Text="Bemerkung"
                    TextColor="#ffffff"
                    VerticalOptions="Center" />
                <Image
                    x:Name="btn_alertmessage_img2"
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    HeightRequest="34"
                    HorizontalOptions="End"
                    IsVisible="False"
                    Source="WarnTriangleYellow.png"
                    VerticalOptions="Center"
                    WidthRequest="34" />
                <Image
                    x:Name="btn_internmessage_img2"
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    IsVisible="True"
                    Source="InternalNoCustomer.png"
                    VerticalOptions="Center"
                    WidthRequest="30" />
            </Grid>

            <BoxView
                Grid.Row="1"
                Margin="0"
                BackgroundColor="Gray"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Start" />

            <VerticalStackLayout
                Grid.Row="2"
                Margin="0"
                Padding="10,15"
                BackgroundColor="#99042d53"
                HorizontalOptions="Fill"
                Spacing="0">
                <Label
                    Margin="0"
                    Padding="0"
                    FontSize="15"
                    HorizontalOptions="Start"
                    LineBreakMode="WordWrap"
                    Text="Erstellen Sie eine Meldung zum Objekt. Fügen Sie Fotos aus der Galerie oder über Ihre Kamera hinzu."
                    TextColor="#cccccc"
                    VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout
                x:Name="noticeFor"
                Grid.Row="3"
                Margin="0"
                Padding="10"
                BackgroundColor="#55042d53"
                HorizontalOptions="Fill"
                IsVisible="False"
                Spacing="0">
                <Label
                    Margin="0"
                    Padding="0"
                    FontSize="14"
                    HorizontalOptions="Start"
                    LineBreakMode="WordWrap"
                    Text="Bemerkung wird zur folgender Position hinzugefügt:"
                    TextColor="#cccccc"
                    VerticalOptions="Center" />
                <VerticalStackLayout
                    x:Name="noticeFor_Pos"
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    Spacing="0" />
            </VerticalStackLayout>
            <BoxView
                Grid.Row="4"
                Margin="0,0,0,0"
                BackgroundColor="Gray"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Start" />
            <VerticalStackLayout
                Grid.Row="5"
                Margin="0"
                Padding="5,5,5,10"
                BackgroundColor="#144d73"
                HeightRequest="92"
                HorizontalOptions="Fill"
                MinimumHeightRequest="92"
                Spacing="0">
                <Label
                    Margin="0"
                    Padding="5,0,0,0"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Start"
                    Text="Bemerkung:"
                    TextColor="#aaaaaa" />
                <vo:CustomEditor
                    x:Name="entry_notice"
                    Margin="0,-10,0,0"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    HeightRequest="100"
                    HorizontalOptions="Fill"
                    Keyboard="Text"
                    MinimumHeightRequest="80"
                    Text=""
                    TextChanged="entry_notice_TextChanged"
                    TextColor="#ffffff" />
            </VerticalStackLayout>
            <BoxView
                Grid.Row="6"
                Margin="0,0,0,0"
                BackgroundColor="Gray"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Start" />
            <Grid
                Grid.Row="7"
                Margin="0"
                Padding="0"
                BackgroundColor="#99042d53"
                ColumnSpacing="10"
                HorizontalOptions="Fill">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <VerticalStackLayout
                    Grid.Column="0"
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    Spacing="0">
                    <Grid
                        Margin="0"
                        Padding="10,5,0,10"
                        ColumnSpacing="10"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="0"
                            FontSize="16"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            Text="Interne Bemerkung"
                            TextColor="#ffffff"
                            VerticalOptions="Center" />
                        <Switch
                            x:Name="sw_internmessage"
                            Grid.Column="1"
                            HorizontalOptions="Start"
                            Toggled="InternMessage_Switch_Toggled"
                            VerticalOptions="Center" />
                        <Switch
                            x:Name="sw_alertmessage"
                            Grid.Column="1"
                            HorizontalOptions="Start"
                            IsVisible="False"
                            Toggled="AlertMessage_Switch_Toggled"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        Margin="10,0,0,6"
                        Padding="0"
                        FontSize="12"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start"
                        Text="Maximal 5 Bilder"
                        TextColor="#ffcc00"
                        VerticalOptions="Center" />
                </VerticalStackLayout>

                <Border
                    x:Name="btn_takePhoto_frame"
                    Grid.Column="1"
                    Margin="3,10,3,0"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <VerticalStackLayout
                        Margin="0"
                        Padding="0"
                        BackgroundColor="#244d73"
                        HeightRequest="44"
                        HorizontalOptions="Center"
                        Spacing="0"
                        VerticalOptions="Center"
                        WidthRequest="44">
                        <Image
                            Margin="0,6,0,0"
                            HeightRequest="32"
                            HorizontalOptions="Center"
                            Source="Cam.png"
                            VerticalOptions="Center"
                            WidthRequest="32" />
                    </VerticalStackLayout>
                </Border>
                <Border
                    x:Name="btn_takePhotoAttachment_frame"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <StackLayout
                        Margin="0"
                        Padding="0"
                        BackgroundColor="#244d73"
                        HeightRequest="44"
                        HorizontalOptions="Center"
                        Spacing="0"
                        VerticalOptions="Center"
                        WidthRequest="44">
                        <Image
                            Margin="0,6,0,0"
                            HeightRequest="32"
                            HorizontalOptions="Center"
                            Source="Attachment.png"
                            VerticalOptions="Center"
                            WidthRequest="32" />
                    </StackLayout>
                </Border>

            </Grid>

            <BoxView
                Grid.Row="8"
                Margin="0,0,0,0"
                BackgroundColor="Gray"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Start" />
            <ScrollView
                Grid.Row="9"
                Margin="0"
                Padding="0"
                HorizontalOptions="Fill"
                VerticalOptions="Start">
                <VerticalStackLayout
                    x:Name="noticePhotoStack"
                    Margin="0"
                    Padding="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Fill"
                    Spacing="0"
                    VerticalOptions="Fill" />
            </ScrollView>
        </Grid>

        <VerticalStackLayout
            x:Name="notizSave_stack"
            Grid.Row="1"
            Margin="0,0,0,15"
            Padding="0"
            BackgroundColor="#333333"
            HeightRequest="60"
            HorizontalOptions="Fill"
            IsVisible="False"
            Spacing="0"
            VerticalOptions="End">
            <BoxView
                Margin="0,0,0,0"
                BackgroundColor="White"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="End" />
            <Border
                x:Name="btn_notice_save"
                Margin="7,5,0,0"
                Padding="1"
                BackgroundColor="#04432d"
                HorizontalOptions="Start">
                <VerticalStackLayout
                    Margin="0"
                    Padding="2,5,10,2"
                    BackgroundColor="#04532d"
                    HeightRequest="44"
                    HorizontalOptions="Fill">
                    <HorizontalStackLayout
                        Margin="0,0,0,0"
                        Padding="0"
                        HeightRequest="30"
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Center">
                        <Image
                            Margin="0,3,8,0"
                            HeightRequest="30"
                            Source="CheckWhite.png"
                            VerticalOptions="Center"
                            WidthRequest="30" />
                        <VerticalStackLayout
                            Margin="0,-3,10,0"
                            Padding="0"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Label
                                Margin="0"
                                Padding="0"
                                FontSize="18"
                                Text="JETZT HINZUFÜGEN"
                                TextColor="#ffffff" />
                            <Label
                                Margin="0,-2,0,0"
                                Padding="0"
                                FontSize="11"
                                Text="Bemerkung zum gewählten Bereich hinzufügen"
                                TextColor="#ffffff" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
