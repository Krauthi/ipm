<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="iPMCloud.Mobile.ScanObjModalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="Objekt QR-Code scannen">



    <Grid
        Margin="0,0,0,0"
        Padding="0"
        AbsoluteLayout.LayoutBounds="0,0,1,1"
        AbsoluteLayout.LayoutFlags="All"
        BackgroundColor="Black"
        HorizontalOptions="Fill"
        RowSpacing="0"
        VerticalOptions="Fill">

        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackLayout
            Grid.Row="0"
            Margin="0"
            HeightRequest="54"
            Padding="0"
            HorizontalOptions="Fill"
            Spacing="0"
            VerticalOptions="Fill">
                <HorizontalStackLayout
                    x:Name="btn_back_inAddRegScan"
                    Margin="0,12,0,5"
                    Padding="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Spacing="0"
                    VerticalOptions="Center">
                    <Image
                        Margin="0,0,10,0"
                        HeightRequest="26"
                        HorizontalOptions="Start"
                        Source="DropLeftBlueDoubleImage.png"
                        VerticalOptions="Center"
                        WidthRequest="26" />
                    <Label
                        Margin="0"
                        FontSize="20"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start"
                        LineBreakMode="TailTruncation"
                        Text="Scann abbrechen"
                        TextColor="#4fa4ed"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
        </StackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,0,0,0"
            Padding="15,15,15,20"
            HeightRequest="130"
            BackgroundColor="#90144d93"
            HorizontalOptions="Fill"
            Spacing="0">
            <Label
                Margin="0"
                Padding="0"
                FontSize="18"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Start"
                Text="Scannen Sie den QR-Code des Objekts, um es zu Ihrer App hinzuzufügen. "
                TextColor="#ffffff"
                VerticalOptions="Start" />
        </VerticalStackLayout>



        <Grid
            Grid.Row="2"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Grid.RowDefinitions>
                <!--<RowDefinition Height="30" />-->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>



                    <zxing:CameraBarcodeReaderView
                Grid.Row="0"
                        x:Name="ReaderView"
                        BarcodesDetected="ReaderView_BarcodesDetected"
                        CameraLocation="Rear"
                        HorizontalOptions="Fill"
                        IsDetecting="True" 
                        VerticalOptions="Fill" />

            <!--  Bottom Stack  -->
            <StackLayout
                Grid.Row="1"
                Margin="0,20,0,40"
                BackgroundColor="Black"
                HorizontalOptions="Fill"
                Spacing="0"
                VerticalOptions="Start">

                <Label
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding BottomText}"
                    TextColor="White">
                </Label>

                <!--  Flash Button  -->
                <Button
                    Margin="0,20,0,0"
                    Padding="8"
                    BackgroundColor="#144D93"
                    Command="{Binding FlashButtonCommand}"
                    CornerRadius="0"
                    HeightRequest="60"
                    HorizontalOptions="Center"
                    ImageSource="Flashlight.png"
                    WidthRequest="60" />
            </StackLayout>

        </Grid>

    </Grid>







</ContentPage>
