<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="iPMCloud.Mobile.Views.MainPageOverlaysView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:views="clr-namespace:iPMCloud.Mobile.Views"
    xmlns:vo="clr-namespace:iPMCloud.Mobile.vo">

    <AbsoluteLayout
        Margin="0,0,0,0"
        Padding="0,0,0,0"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <AbsoluteLayout
            x:Name="CheckPage_Container"
            Margin="0,0,0,0"
            Padding="0"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            HorizontalOptions="Fill"
            IsVisible="False"
            VerticalOptions="Fill">

            <Image
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Aspect="Fill"
                HorizontalOptions="Center"
                Opacity="1"
                Source="backgroundgray2.jpg"
                VerticalOptions="End" />

            <Grid
                x:Name="CheckPage_position_Container"
                Margin="0"
                Padding="0"
                HorizontalOptions="Fill"
                RowSpacing="0"
                VerticalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="0"
                    Padding="10,10,10,10"
                    ColumnSpacing="0"
                    HeightRequest="48"
                    HorizontalOptions="Fill">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="btn_back_check"
                        Grid.Column="0"
                        Margin="3,2,2,2"
                        Padding="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        Stroke="Transparent"
                        VerticalOptions="Center">
                        <Grid
                            Margin="0"
                            Padding="0"
                            ColumnSpacing="0"
                            HeightRequest="38"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                HeightRequest="30"
                                HorizontalOptions="Start"
                                Source="DropLeftBlueDoubleImage.png"
                                VerticalOptions="Center"
                                WidthRequest="30" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="0"
                                Padding="0"
                                HorizontalOptions="Start"
                                Spacing="0">
                                <Label
                                    Margin="0,0,0,-2"
                                    Padding="0"
                                    FontSize="18"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    LineBreakMode="TailTruncation"
                                    Text="ZURÜCK"
                                    TextColor="#2f84bd"
                                    VerticalOptions="Center" />
                                <Label
                                    Margin="0"
                                    Padding="0"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    LineBreakMode="TailTruncation"
                                    Text="und Speichern"
                                    TextColor="#4fa4dd"
                                    VerticalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Label
                        Grid.Column="1"
                        Margin="0"
                        FontSize="22"
                        HorizontalOptions="End"
                        HorizontalTextAlignment="End"
                        LineBreakMode="TailTruncation"
                        Text="Checkliste bearbeiten"
                        TextColor="#ffffff"
                        VerticalOptions="Center" />

                </Grid>
                <BoxView
                    Grid.Row="1"
                    Margin="0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />

                <Grid
                    Grid.Row="2"
                    Margin="0"
                    Padding="10,5,10,3"
                    BackgroundColor="#55042d53"
                    ColumnSpacing="0"
                    HorizontalOptions="Fill">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="0"
                        HeightRequest="30"
                        HorizontalOptions="Start"
                        Source="CheckSymbol.png"
                        VerticalOptions="Start"
                        WidthRequest="30" />
                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="0"
                        Padding="10,0,10,5"
                        HorizontalOptions="Fill"
                        Spacing="0">
                        <Label
                            x:Name="btn_info_check_text1"
                            Margin="0"
                            Padding="0"
                            FontSize="14"
                            HorizontalOptions="Start"
                            LineBreakMode="WordWrap"
                            Text="Checkliste:"
                            TextColor="#cccccc"
                            VerticalOptions="Start" />
                        <Label
                            x:Name="btn_info_check_text2"
                            Margin="0"
                            Padding="0"
                            FontSize="14"
                            HorizontalOptions="Start"
                            LineBreakMode="WordWrap"
                            Text="Bezeichnung:"
                            TextColor="#cccccc"
                            VerticalOptions="Start" />
                    </VerticalStackLayout>
                    <VerticalStackLayout
                        x:Name="frame_info_check_badge"
                        Grid.Column="2"
                        Margin="0"
                        Padding="0"
                        HorizontalOptions="End"
                        Spacing="0"
                        VerticalOptions="Center" />
                    <Border
                        x:Name="btn_check_del"
                        Grid.Column="3"
                        Margin="13,0,0,0"
                        Padding="1"
                        BackgroundColor="#73042d"
                        HorizontalOptions="End"
                        Stroke="#73143d"
                        VerticalOptions="Center">
                        <HorizontalStackLayout
                            Margin="0"
                            Padding="0"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            Spacing="0"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <Image
                                Margin="0,0,0,0"
                                HeightRequest="29"
                                HorizontalOptions="Center"
                                Source="Trash.png"
                                VerticalOptions="Center"
                                WidthRequest="30" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <BoxView
                    Grid.Row="3"
                    Margin="0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />

                <HorizontalStackLayout
                    Grid.Row="4"
                    Margin="0,25,0,0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    Spacing="10">
                    <Border
                        x:Name="btn_check_sub"
                        Margin="0"
                        Padding="15,10,15,10"
                        BackgroundColor="#73042d"
                        HorizontalOptions="Center"
                        IsVisible="TRUE">
                        <Label
                            Margin="0"
                            Padding="0"
                            FontSize="16"
                            Text="VORHERIGE"
                            TextColor="#ffffff" />
                    </Border>
                    <Border
                        x:Name="btn_check_add"
                        Margin="0"
                        Padding="15,10,15,10"
                        BackgroundColor="#042d53"
                        HorizontalOptions="Center"
                        IsVisible="True">
                        <Label
                            Margin="0"
                            Padding="0"
                            FontSize="16"
                            Text="NÄCHSTE"
                            TextColor="#ffffff" />
                    </Border>
                    <Border
                        x:Name="btn_check_ready"
                        Margin="0"
                        Padding="15,10,15,10"
                        BackgroundColor="#04732d"
                        HorizontalOptions="Center"
                        IsVisible="true">
                        <Label
                            Margin="0"
                            Padding="0"
                            FontSize="16"
                            Text="FERTIG"
                            TextColor="#ffffff" />
                    </Border>
                </HorizontalStackLayout>

                <BoxView
                    Grid.Row="5"
                    Margin="0,0,0,0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />

                <ScrollView
                    x:Name="checkQuestStack_scroll"
                    Grid.Row="6"
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <VerticalStackLayout
                        x:Name="checkQuestStack"
                        Margin="0"
                        Padding="0"
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill" />
                </ScrollView>
            </Grid>


            <VerticalStackLayout
                x:Name="img_info_check_typ_container"
                Margin="0"
                Padding="0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="#99042d53"
                HorizontalOptions="Fill"
                Spacing="0"
                VerticalOptions="End">
                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />
                <HorizontalStackLayout
                    Margin="0"
                    Padding="10,5"
                    HorizontalOptions="Fill"
                    Spacing="0"
                    VerticalOptions="End">
                    <Border
                        x:Name="btn_notice_save_check_ready"
                        Margin="0,5,0,0"
                        Padding="1"
                        BackgroundColor="#04432d"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        VerticalOptions="Start">
                        <StackLayout
                            Margin="0"
                            Padding="10,0"
                            BackgroundColor="#04532d"
                            HeightRequest="44"
                            HorizontalOptions="Fill">
                            <HorizontalStackLayout
                                Margin="0,0,0,0"
                                Padding="0"
                                HorizontalOptions="Fill"
                                Spacing="0"
                                VerticalOptions="Center">
                                <VerticalStackLayout
                                    Margin="0,-3,10,0"
                                    Padding="0"
                                    Spacing="0"
                                    VerticalOptions="Center">
                                    <Label
                                        Margin="0"
                                        Padding="0"
                                        FontSize="16"
                                        Text="FERTIG"
                                        TextColor="#ffffff" />
                                    <Label
                                        Margin="0"
                                        Padding="0"
                                        FontSize="10"
                                        LineBreakMode="TailTruncation"
                                        Text="Checkliste abgeben"
                                        TextColor="#ffffff" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </StackLayout>
                    </Border>
                    <VerticalStackLayout
                        Margin="0"
                        Padding="10,0,10,20"
                        HorizontalOptions="Center"
                        Spacing="0">
                        <Label
                            x:Name="info_check_text1a"
                            Margin="0"
                            Padding="0"
                            FontSize="14"
                            HorizontalOptions="Start"
                            LineBreakMode="TailTruncation"
                            Text="Gesamt"
                            TextColor="#cccccc"
                            VerticalOptions="Start" />
                        <Label
                            x:Name="info_check_text2a"
                            Margin="0"
                            Padding="0"
                            FontSize="14"
                            HorizontalOptions="Start"
                            LineBreakMode="TailTruncation"
                            Text="0 vom 0 beantwortet"
                            TextColor="#cccccc"
                            VerticalOptions="Start" />
                        <Label
                            x:Name="info_check_text3a"
                            Margin="0"
                            Padding="0"
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Start"
                            IsVisible="False"
                            LineBreakMode="TailTruncation"
                            Text="Es müssen alle Pflichtfragen beantwortet werden!"
                            TextColor="#ffcc00"
                            VerticalOptions="Start" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </AbsoluteLayout>


        <AbsoluteLayout
            x:Name="CheckPage_Signature_Container"
            Margin="0,0,0,0"
            Padding="0"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            HorizontalOptions="Fill"
            IsVisible="False"
            VerticalOptions="Fill">

            <Image
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Aspect="Fill"
                HorizontalOptions="Center"
                Opacity="1"
                Source="backgroundgray2.jpg"
                VerticalOptions="End" />

            <Grid
                x:Name="CheckPage_position_Container2"
                Margin="0"
                Padding="0"
                HorizontalOptions="Fill"
                RowSpacing="0"
                VerticalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="0"
                    Padding="10,10,10,10"
                    ColumnSpacing="0"
                    HeightRequest="48"
                    HorizontalOptions="Fill">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="btn_back_check_signature"
                        Grid.Column="0"
                        Margin="3,2,2,2"
                        Padding="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        Stroke="Transparent"
                        VerticalOptions="Center">
                        <Grid
                            Margin="0"
                            Padding="0"
                            ColumnSpacing="0"
                            HeightRequest="38"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                HeightRequest="30"
                                HorizontalOptions="Start"
                                Source="DropLeftBlueDoubleImage.png"
                                VerticalOptions="Center"
                                WidthRequest="30" />
                            <Label
                                Grid.Column="1"
                                Margin="0"
                                FontSize="18"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="TailTruncation"
                                Text="ZURÜCK"
                                TextColor="#2f84bd"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label
                        Grid.Column="1"
                        Margin="0"
                        FontSize="22"
                        HorizontalOptions="Fill"
                        LineBreakMode="TailTruncation"
                        Text="Unterschrift hinzufügen"
                        TextColor="#ffffff"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView
                    Grid.Row="1"
                    Margin="0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />

                <ScrollView
                    x:Name="checkQuestStack_signature_scroll"
                    Grid.Row="2"
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <VerticalStackLayout
                        x:Name="checkQuestStack_signature"
                        Margin="0"
                        Padding="0"
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill" />
                </ScrollView>
            </Grid>

        </AbsoluteLayout>


        <AbsoluteLayout
            x:Name="CheckPage_Bem_Container"
            Margin="0,0,0,0"
            Padding="0"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            BackgroundColor="Black"
            HorizontalOptions="Fill"
            IsVisible="False"
            VerticalOptions="Fill">
            <Image
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Aspect="Fill"
                HorizontalOptions="Center"
                Opacity="0.7"
                Source="backgroundgray2.jpg"
                VerticalOptions="End" />

            <StackLayout
                x:Name="CheckPage_Bem_inner_Container"
                Margin="0"
                Padding="0"
                HorizontalOptions="Fill"
                Spacing="0"
                VerticalOptions="Fill">

                <Grid
                    Margin="0"
                    Padding="10"
                    ColumnSpacing="0"
                    HeightRequest="48"
                    HorizontalOptions="Fill">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="btn_back_notice_check_bem"
                        Grid.Column="0"
                        Margin="3,2,2,2"
                        Padding="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        Stroke="Transparent"
                        VerticalOptions="Center">
                        <Grid
                            Margin="0"
                            Padding="0"
                            ColumnSpacing="0"
                            HeightRequest="38"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                HeightRequest="30"
                                HorizontalOptions="Start"
                                Source="DropLeftBlueDoubleImage.png"
                                VerticalOptions="Center"
                                WidthRequest="30" />
                            <Label
                                Grid.Column="1"
                                Margin="0"
                                FontSize="16"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="TailTruncation"
                                Text="ABBRECHEN"
                                TextColor="#2f84bd"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label
                        x:Name="CheckPage_Bem_Title"
                        Grid.Column="1"
                        Margin="0,0,5,0"
                        FontSize="22"
                        HorizontalOptions="End"
                        HorizontalTextAlignment="End"
                        LineBreakMode="TailTruncation"
                        Text="Foto/Bemerkung"
                        TextColor="#ffffff"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />

                <VerticalStackLayout
                    Margin="0"
                    Padding="10,5"
                    BackgroundColor="#33042d53"
                    HorizontalOptions="Fill"
                    Spacing="0">
                    <Label
                        Margin="0"
                        Padding="0"
                        FontSize="12"
                        HorizontalOptions="Start"
                        Text="Fügen Sie hier Fotos aus der Galerie oder direkt über die Kamera hinzu."
                        TextColor="#cccccc"
                        VerticalOptions="Center" />
                    <Label
                        Margin="0,0,0,5"
                        Padding="0,5,0,0"
                        FontSize="13"
                        HorizontalOptions="Start"
                        LineBreakMode="WordWrap"
                        Text="Wird zur folgender Frage hinzugefügt:"
                        TextColor="#cccccc"
                        VerticalOptions="Center" />
                    <VerticalStackLayout
                        x:Name="noticeFor_Pos_check_bem"
                        Margin="0,0,0,5"
                        Padding="0"
                        HorizontalOptions="Fill"
                        Spacing="0" />
                </VerticalStackLayout>
                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />
                <VerticalStackLayout
                    x:Name="entry_notice_container_check_bem"
                    Margin="0"
                    Padding="5"
                    BackgroundColor="#144d73"
                    HeightRequest="92"
                    HorizontalOptions="Fill"
                    MinimumHeightRequest="92"
                    Spacing="0">
                    <Label
                        Margin="0"
                        Padding="5,0,0,0"
                        FontSize="12"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start"
                        Text="Text:"
                        TextColor="#aaaaaa" />
                    <vo:CustomEditor
                        x:Name="entry_notice_check_bem"
                        Margin="0,-10,0,0"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        HeightRequest="100"
                        HorizontalOptions="Fill"
                        Keyboard="Text"
                        MinimumHeightRequest="80"
                        Text=""
                        TextChanged="entry_notice_TextChanged_check_bem"
                        TextColor="#ffffff" />
                </VerticalStackLayout>
                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />
                <Grid
                    x:Name="photobar_check_bem"
                    Margin="0"
                    Padding="0,5,0,0"
                    BackgroundColor="#55042d53"
                    ColumnSpacing="0"
                    HorizontalOptions="Fill">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Margin="0"
                        Padding="0,2,10,7"
                        ColumnSpacing="10"
                        HorizontalOptions="Fill"
                        VerticalOptions="End">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="btn_takePhoto_frame_check_bem"
                            Grid.Column="0"
                            Margin="15,0,15,0"
                            Padding="1"
                            BackgroundColor="#041d43"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            <StackLayout
                                Margin="0"
                                Padding="0"
                                BackgroundColor="#042d53"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Spacing="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Image
                                    Margin="0,0,0,0"
                                    HeightRequest="30"
                                    HorizontalOptions="Center"
                                    Source="Cam.png"
                                    VerticalOptions="Center"
                                    WidthRequest="30" />
                            </StackLayout>
                        </Border>
                        <Border
                            x:Name="btn_takePhotoAttachment_frame_check_bem"
                            Grid.Column="1"
                            Margin="5,0,15,0"
                            Padding="1"
                            BackgroundColor="#041d43"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            <StackLayout
                                Margin="0"
                                Padding="0"
                                BackgroundColor="#042d53"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Spacing="0"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Image
                                    Margin="0,0,0,0"
                                    HeightRequest="30"
                                    HorizontalOptions="Center"
                                    Source="Attachment.png"
                                    VerticalOptions="Center"
                                    WidthRequest="30" />
                            </StackLayout>
                        </Border>
                    </Grid>
                    <Label
                        Grid.Column="1"
                        Margin="20,0,20,6"
                        Padding="0"
                        FontSize="12"
                        HorizontalOptions="End"
                        LineBreakMode="WordWrap"
                        Text="Maximal 3 Bilder"
                        TextColor="#ffcc00"
                        VerticalOptions="Center" />
                </Grid>

                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />
                <ScrollView
                    x:Name="noticePhotoStack_scroll_check_bem"
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">
                    <VerticalStackLayout
                        x:Name="noticePhotoStack_check_bem"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill" />
                </ScrollView>

                <VerticalStackLayout
                    Margin="0,0,0,12"
                    Padding="0"
                    HeightRequest="55"
                    HorizontalOptions="Fill"
                    Spacing="0"
                    VerticalOptions="End">
                    <BoxView
                        Margin="0,0,0,0"
                        BackgroundColor="White"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        VerticalOptions="End" />
                    <Border
                        x:Name="btn_notice_save_check_bem"
                        Margin="5"
                        Padding="1"
                        BackgroundColor="#04432d"
                        HorizontalOptions="Start">
                        <StackLayout
                            Margin="0"
                            Padding="2,2,10,2"
                            BackgroundColor="#04532d"
                            HeightRequest="40"
                            HorizontalOptions="Fill">
                            <HorizontalStackLayout
                                Margin="0,0,0,0"
                                Padding="0"
                                HeightRequest="30"
                                HorizontalOptions="Fill"
                                Spacing="0"
                                VerticalOptions="Center">
                                <Image
                                    Margin="0,0,8,0"
                                    HeightRequest="30"
                                    Source="CheckWhite.png"
                                    VerticalOptions="Center"
                                    WidthRequest="30" />
                                <VerticalStackLayout
                                    Margin="0,-3,10,0"
                                    Padding="0"
                                    Spacing="0"
                                    VerticalOptions="Center">
                                    <Label
                                        Margin="0"
                                        Padding="0"
                                        FontSize="16"
                                        Text="ÜBERNEHMEN"
                                        TextColor="#ffffff" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </StackLayout>
                    </Border>
                </VerticalStackLayout>
            </StackLayout>
        </AbsoluteLayout>






        <AbsoluteLayout
            x:Name="popupContainer_quest_langpicker"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            BackgroundColor="#88000000"
            IsVisible="False">
            <Grid
                x:Name="popupContainer_quest_langpicker_inner"
                Margin="20,20,0,0"
                Padding="0"
                BackgroundColor="#144d73"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
