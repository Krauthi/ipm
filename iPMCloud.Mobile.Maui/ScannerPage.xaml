<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="iPMCloud.Mobile.ScannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:iPMCloud.Mobile.vo"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    Title="Scanner">

    <Grid Padding="0" RowDefinitions="*,Auto">
        <zxing:CameraBarcodeReaderView
            x:Name="ReaderView"
            BarcodesDetected="ReaderView_BarcodesDetected"
            CameraLocation="Rear"
            IsDetecting="True" />

        <HorizontalStackLayout
            Grid.Row="1"
            Padding="12"
            Spacing="12">
            <Button Clicked="OnSwitchCameraClicked" Text="Kamera wechseln" />
            <Button Clicked="OnCancelClicked" Text="Abbrechen" />
            <Label x:Name="StatusLabel" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>